{
  "manifest_version": 3,
  "name": "HeaderDial – Modify HTTP Request & Response Headers",
  "short_name": "HeaderDial",
  "version": "0.2.0",
  "description": "Add, change or remove HTTP request and response headers. Profiles, URL filters, timed headers. Open source, no tracking.",
  "homepage_url": "https://janwan2003.github.io/request-headers/",
  "permissions": ["declarativeNetRequest", "storage", "alarms", "activeTab"],
  "optional_host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "HeaderDial",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "options_ui": { "page": "popup.html?page=1", "open_in_tab": true },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+H" }, "description": "Open HeaderDial" },
    "toggle-pause": { "suggested_key": { "default": "Alt+Shift+D" }, "description": "Pause or resume all header changes" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "minimum_chrome_version": "111"
}
